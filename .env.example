# --- Guion (opcional: sin clave puedes escribir el guion a mano con "new --manual") ---
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-5-5

# --- Voz clonada (opcional: sin clave usa --mode recorded y graba con tu microfono) ---
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=eleven_multilingual_v2

# --- YouTube (solo para "publish" y "metrics") ---
# Descarga el JSON del cliente OAuth (tipo "App de escritorio") y guardalo aqui:
YOUTUBE_CLIENT_SECRET_FILE=secrets/client_secret.json

# --- Opcionales ---
MAX_SECONDS=60
# BROWSER_EXECUTABLE=C:\Program Files\Google\Chrome\Application\chrome.exe

# ================= CLIPPER (npm start) =================
# Todo es opcional: sin nada de esto detecta por volumen y palabras, gratis.
# IA gratuita en tu PC para valorar los momentos: instala Ollama y pon aqui el modelo, p. ej. llama3.1
# OLLAMA_MODEL=llama3.1
# IA gratis en la nube para las tareas dificiles (donde cortar, titulos). Clave gratis en console.groq.com
# GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-120b
# (o usa ANTHROPIC_API_KEY de arriba, de pago: lo ultimo)
# Modelo de voz para subtitulos. "base" es mas rapido y menos preciso; "small" es el equilibrio.
# WHISPER_MODEL=onnx-community/whisper-base_timestamped
# MAX_MOMENTS=15
# PORT=4300
# YTDLP_PATH=C:\herramientas\yt-dlp.exe
# IA de vision opcional: mira los fotogramas de cada momento (muerte, victoria, jugada...).
# Con Ollama: OLLAMA_VISION_MODEL=llava   |   Con la API de arriba: VISION_IA=1
# OLLAMA_VISION_MODEL=llava
# VISION_IA=1
